# ══════════════════════════════════════════════════
#  PumBot – Environment Variables
# ══════════════════════════════════════════════════
#  Kopiere diese Datei nach .env und fülle die Werte aus.
#  cp .env.example .env
# ══════════════════════════════════════════════════

# ── Discord Bot ──
DISCORD_TOKEN=dein-bot-token-hier
DISCORD_GUILD_ID=1441169067326177405
# Optional: nur auf 1 setzen, wenn Presence Intent im Discord Developer Portal aktiviert ist.
ENABLE_PRESENCE_INTENT=1

# ── Discord OAuth2 (Web-Panel Login) ──
#  Erstelle eine App unter https://discord.com/developers/applications
#  -> OAuth2 -> Redirects -> http://127.0.0.1:3000/auth/discord/callback
DISCORD_CLIENT_ID=deine-client-id
DISCORD_CLIENT_SECRET=dein-client-secret
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback

# ── Rollen / Berechtigungen ──
DEFAULT_ADMIN_ROLE_ID=1441253029432262787

# ── Flask / Web-Panel ──
FLASK_SECRET_KEY=ein-langer-zufaelliger-string
BASE_URL=http://127.0.0.1:3000
PORT=3000

# ── API-Key (Bot <-> Flask Kommunikation) ──
LOG_API_KEY=ein-sicherer-api-key

# ── Twitch API ──
#  https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_AUTH_TOKEN=
TWITCH_USER_LOGIN=
TWITCH_PING_ROLE_ID=1261003159896195154

# ── DeepSeek ──
DEEPSEEK_API_KEY=dein-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_MODE=0

# ── Optional ──
# API_BASE_URL=http://127.0.0.1:3000
# TICKET_VIEW_BASE_URL=http://127.0.0.1:3000/tickets
